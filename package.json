{
  "name": "aidtrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "contract:test": "gltest tests/direct -v",
    "contract:integration": "gltest tests/integration -v",
    "verify:live": "node scripts/verify-live.mjs",
    "deploy:dry-run": "npx tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "genlayer-js": "1.1.8",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
