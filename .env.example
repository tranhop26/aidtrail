# Public browser configuration. Leave blank until a verified Studionet deployment exists.
NEXT_PUBLIC_AIDTRAIL_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_CHAIN_ID=

# Operator-only configuration. Never expose these in NEXT_PUBLIC_* variables or commit a populated .env file.
AIDTRAIL_NETWORK=studionet
AIDTRAIL_STUDIONET_RPC_URL=
AIDTRAIL_DEPLOYER_PRIVATE_KEY=

# Post-deployment verifier inputs. AIDTRAIL_EVIDENCE_FILE defaults to docs/live-verification.json.
AIDTRAIL_CONTRACT_ADDRESS=
AIDTRAIL_EVIDENCE_FILE=
